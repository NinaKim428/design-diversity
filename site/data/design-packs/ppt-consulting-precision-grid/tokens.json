    "data": ["#0B5FFF", "#C9CDD3"],
    "data_series2": ["#0B5FFF", "#9CA3AF"],
    "highlight": "#0B5FFF",
    "neutral_bar": "#C9CDD3",
    "axis": "0.75pt #D1D5DB x-baseline only, y-axis omitted",
    "gridline": "0-1 only, 0.5pt #E5E7EB",
