    "category_label": "11pt #6B7280, under bar",
    "line": "1.75pt solid, straight segments, markers 6px at endpoints only, no area fill",
    "bar_gap_ratio": "bar:gap = 3:2",
    "baseline": "0 (data zero, no truncated/zoomed axis)",
    "render": "SVG precise, square corners, no border box, no legend box, no shadow, no bevel/gloss/3D",
    "source": "unit note + bottom-right 9pt caption mandatory"
  },
  "diagram": {
    "language": "hairline square nodes + 0.75pt straight connectors + circular number badges, accent #0B5FFF only on active element",
    "node": { "shape": "square (radius 0)", "size": "2.1in x 0.9in", "border": "1px solid #D1D5DB", "fill": "#F4F5F7", "active_border": "4px left #0B5FFF" },
    "connector": { "stroke": "0.75pt #1A1A1A straight", "arrowhead": "4px triangle", "curve": "none" },
    "badge": { "shape": "circle", "size": "0.28in", "border": "1px solid #0B5FFF", "fill": "#FFFFFF", "text": "12pt Bold #0B5FFF" },
    "process": { "steps": "4-5 horizontal", "highlight": "1 active step, 4px left #0B5FFF border" },
    "timeline": { "axis": "0.75pt #D1D5DB hairline", "marker": "0.12in square #1A1A1A, current = #0B5FFF + vertical hairline + 9pt label" },
    "comparison": { "columns": "2-3, 1px #D1D5DB divider", "row_rule": "0.5pt #E5E7EB", "winner": "4px left #0B5FFF on header" },
    "matrix": { "size": "4.0in square", "axis": "0.75pt #D1D5DB cross", "point": "0.16in circle, neutral #C9CDD3 / key #0B5FFF", "quadrant_fill": "top-right #F4F5F7 only" },
    "funnel": { "levels": "3-5 vertical, width -1.0in per step (funnel) or equal stack (hierarchy)", "highlight": "1 level, 4px left #0B5FFF" },
