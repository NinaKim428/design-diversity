{
  "slug": "ppt-editorial-magazine",
  "track": "ppt",
  "family": "editorial-magazine",
  "color": {
    "bg": "#FBFAF7",
    "surface": "#FBFAF7",
    "text": "#1C1B19",
    "text_muted": "#8A8782",
    "accent": ["#A8312A"],
    "border": "#C9C5BC"
  },
  "type": {
    "display": { "family": "Playfair Display", "fallback": "Georgia, Noto Serif KR", "size": "40pt", "weight": 700, "tracking": "-0.01em", "leading": 1.1 },
    "subhead": { "family": "Playfair Display", "size": "22pt", "weight": 400, "style": "italic" },
    "body": { "family": "Source Serif Pro", "fallback": "Georgia, Noto Serif KR", "size": "17pt", "weight": 400, "leading": 1.45 },
    "dropcap": { "family": "Playfair Display", "size": "54pt", "weight": 700, "color": "#A8312A", "span_lines": 3 },
    "kicker": { "family": "Arial", "fallback": "Helvetica, Pretendard", "size": "11pt", "weight": 700, "tracking": "0.12em", "case": "uppercase", "color": "#A8312A" },
    "caption": { "family": "Arial", "size": "10pt", "weight": 400, "style": "italic", "color": "#8A8782" }
  },
  "spacing": { "unit": 8, "margin_x": "0.7in", "margin_y": "0.6in", "column_gap": "0.3in", "column_ratio": "5:7" },
  "shape": { "radius": "0px", "border": "none", "rule": "0.5pt #C9C5BC", "shadow": "none" },
  "chart": {
    "plot_area": "column-width 4.5in (narrow) / 6.2in (wide), height 2.4-3.2in",
    "type_match": "comparison=column, trend=line, share=donut(<=3)/100%-stacked, change=slope",
    "data": ["#1C1B19", "#A8312A"],
    "highlight": "#A8312A",
    "neutral_series": "#8A8782",
    "axis": "0.75pt #1C1B19 x-baseline only, y-axis omitted",
    "gridline": "none",
    "separator": "0.5pt #C9C5BC hairline rule above/below chart",
    "value_label": "13pt Source Serif Pro Regular, tabular figures, direct on bar/vertex",
    "axis_caption": "10pt Arial Italic #8A8782",
    "line": "1.5pt solid, straight segments, markers 5px at endpoints only, no area fill",
    "bar_gap_ratio": "bar:gap = 3:2",
    "baseline": "0 (data zero, no truncated/zoomed axis)",
    "render": "SVG precise, square corners, no border box, no legend box, no shadow/gloss/bevel/3D"
  },
  "diagram": {
    "language": "square hairline nodes (no fill) + 0.5pt ink connectors + serif number badges, spot color #A8312A on one element only",
    "node": { "shape": "square (radius 0)", "size": "2.0in x 0.85in", "border": "0.5pt #C9C5BC hairline", "fill": "none (#FBFAF7 page)", "highlight_border": "1pt #A8312A" },
    "connector": { "stroke": "0.5pt #1C1B19 ink straight", "arrowhead": "5px triangle", "curve": "none" },
    "badge": { "shape": "circle", "size": "0.3in", "border": "0.5pt #1C1B19", "text": "13pt Playfair Display Bold", "highlight": "#A8312A fill + white digit" },
    "process": { "steps": "4-5 horizontal", "separator": "0.5pt #C9C5BC rule above/below", "highlight": "1 step 1pt #A8312A border" },
    "timeline": { "axis": "0.5pt #1C1B19 ink hairline", "marker": "0.1in circle #1C1B19, current = #A8312A 0.16in + 10pt Arial Italic label", "date_label": "10pt Arial Italic #8A8782", "event_label": "13pt Source Serif Pro" },
    "comparison": { "columns": "2 (5:7 or 1:1)", "divider": "0.5pt #C9C5BC hairline rule", "header": "22pt Playfair Display Italic", "winner": "header #A8312A" },
    "matrix": { "size": "4.2in", "axis": "0.5pt #1C1B19 ink cross", "axis_label": "11pt uppercase kicker #A8312A", "point": "0.14in circle, neutral #1C1B19 / key #A8312A", "quadrant_fill": "key quadrant #C9C5BC 25% only" },
    "funnel": { "levels": "3-5 vertical, width -0.9in per step (funnel) or equal stack (hierarchy)", "border": "0.5pt #C9C5BC hairline, no fill", "highlight": "1 level 1pt #A8312A border" },
    "kpi_card": { "shape": "no box — bracketed by 0.5pt #C9C5BC rules", "label": "11pt uppercase kicker #A8312A", "value": "40pt Playfair Display Bold #1C1B19 tabular", "delta": "10pt Arial Italic #8A8782, ▲/▼" }
  },
  "slide": {
    "size": "13.33x7.5in",
    "columns": "2 (5:7 asymmetric) or 3",
    "photo": "full-cut rectangular, fills column edge-to-edge",
    "pull_quote": "24pt italic + vermilion quote mark",
    "transition": "fade 0.4s"
  }
}
